# Both values are PUBLIC (they end up in the built page). On GitHub they are
# repository *variables*, not secrets: Settings > Secrets and variables > Actions > Variables.
# The Apps Script web-app URL (Deploy > Manage deployments > Web app URL)
VITE_API_URL=
# The Google OAuth "Web client" id used for "Sign in with Google"
VITE_GOOGLE_CLIENT_ID=
